# Local development template.
#   cp .env.local.example .env.local
#
# The app runs WITHOUT any Supabase values (cloud sync is off in V1). To use the local
# Supabase stack, run `npm run db:start`, then copy the values it prints
# (or `npx supabase status`) into the placeholders below.
# NEXT_PUBLIC_APP_ENV=local only accepts local Supabase URLs (never a hosted project).

NEXT_PUBLIC_APP_NAME=Teka Edu
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_COUNTRY=CD

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Values returned by local Supabase ("Project URL" / "Publishable" in `supabase status`).
# Leave both empty to run without Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<LOCAL_SUPABASE_PUBLISHABLE_KEY>

# "Secret" in `supabase status`. Server only.
SUPABASE_SECRET_KEY=<LOCAL_SUPABASE_SECRET_KEY>

# "Database URL" in `supabase status`. Locally the same URL serves both purposes.
DATABASE_URL=<LOCAL_SUPABASE_DATABASE_URL>
DIRECT_DATABASE_URL=<LOCAL_SUPABASE_DIRECT_DATABASE_URL>

NEXT_PUBLIC_ENABLE_ENGLISH_SCAFFOLDING=true
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

AI_ENABLED=false
