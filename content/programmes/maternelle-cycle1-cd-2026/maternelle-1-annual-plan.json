    },
    {
      "code": "P3",
      "name": "Période 3 (trimestre 2)",
      "fromDay": 80,
      "toDay": 107,
      "focus": "Dire ce qu’on fait et ce qu’on a fait ; petites collections jusqu’à quatre ; premiers tracés."
    },
