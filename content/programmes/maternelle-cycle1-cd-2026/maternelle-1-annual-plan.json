      "code": "P4",
      "name": "Période 4 (trimestre 2)",
      "fromDay": 108,
      "toDay": 127,
      "focus": "Comptines et sons de la langue ; comparer des longueurs ; motifs répétitifs simples."
    },
    {
      "code": "P5",
      "name": "Période 5 (trimestre 3)",
      "fromDay": 128,
      "toDay": 160,
      "focus": "Composer et décomposer deux et trois ; se repérer dans l’espace proche ; matières et objets."
    },
    {
      "code": "P6",
      "name": "Période 6 (trimestre 3)",
      "fromDay": 161,
      "toDay": 189,
      "focus": "Reprendre toute l’année en jouant : ce qui est su doit être redit, remontré, rejoué."
    }
