# STAGING reference values (Vercel Preview/Staging + Supabase DEV project `teka-edu-dev`).
#
# This file documents what the Vercel staging environment must contain. It is NOT loaded
# by Next.js and must NOT be copied to .env.development(.local) for daily local work: use
# .env.local instead. Configure these values in Vercel (see docs/ENVIRONMENT_SETUP.md).
# Never put real values in this committed template.

NEXT_PUBLIC_APP_NAME=Teka Edu
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_COUNTRY=CD

NEXT_PUBLIC_APP_ENV=staging

NEXT_PUBLIC_APP_URL=<STAGING_VERCEL_URL>

NEXT_PUBLIC_SUPABASE_URL=https://<DEV_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<DEV_SUPABASE_PUBLISHABLE_KEY>

SUPABASE_SECRET_KEY=<DEV_SUPABASE_SECRET_KEY>

DATABASE_URL=<DEV_SUPABASE_DATABASE_POOLER_URL>
DIRECT_DATABASE_URL=<DEV_SUPABASE_DIRECT_DATABASE_URL>

NEXT_PUBLIC_ENABLE_ENGLISH_SCAFFOLDING=true
# The spec's target value is true. Keep false until cloud sync is implemented: no feature
# uses Supabase yet, and true makes the Supabase browser variables mandatory.
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

AI_ENABLED=false

# Vercel routes traffic to this port; the container listens on it (Dockerfile.vercel).
PORT=3000
