{
  "name": "teka-edu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "registry:prune": "tsx scripts/prune-registry.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --lang typescript --local > lib/supabase/database.types.ts",
    "docker:build": "docker build -t teka-edu:local .",
    "docker:run": "docker run --rm -p 3000:3000 --name teka-edu-local teka-edu:local",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:validate && npm run build",
    "docker:smoke": "bash scripts/docker-smoke.sh teka-edu:local",
    "db:reference": "tsx scripts/generate-reference-sql.ts",
    "calendar:report": "tsx scripts/calendar-report.ts",
    "programme:report": "tsx scripts/programme-report.ts",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "media:report": "tsx scripts/media-report.ts",
    "review:package": "tsx scripts/review-package.ts",
    "plan:report": "tsx scripts/plan-report.ts",
    "review:reconfirmation": "tsx scripts/reconfirmation-package.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
