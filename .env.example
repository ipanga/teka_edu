# ==========================================================
# TEKA EDU — Environment Variables (canonical template)
# ==========================================================
# Documentation and ownership of every variable: docs/ENVIRONMENT_VARIABLES.md
# Validation: lib/env/schema.ts (the app refuses to start with an invalid configuration).
#
# Per-environment templates:
#   .env.local.example        -> copy to .env.local for local development
#   .env.development.example  -> reference values for STAGING (Vercel Preview/Staging)
#   .env.production.example   -> reference values for PRODUCTION (Vercel Production)
#
# NEVER commit real values. Hosted values live in Vercel and GitHub, not in files.
# CI/CD deployment credentials (VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN, ...) are NOT app
# variables and never belong in these files: see docs/ENVIRONMENT_SETUP.md.

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Teka Edu
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_COUNTRY=CD

# local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------
# Supabase — Browser-safe variables
# (optional while NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false; set both or neither)
# ----------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------
# Supabase — Server only
# NEVER expose these using NEXT_PUBLIC_
# ----------------------------------------------------------

SUPABASE_SECRET_KEY=

# ----------------------------------------------------------
# Database — Server / migration tooling only
# (planned: no application code uses them yet)
# ----------------------------------------------------------

DATABASE_URL=
DIRECT_DATABASE_URL=

# ----------------------------------------------------------
# Optional feature flags
# ----------------------------------------------------------

NEXT_PUBLIC_ENABLE_ENGLISH_SCAFFOLDING=true
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

# Must stay false in V1 (ADR-002); the app refuses to start otherwise.
AI_ENABLED=false

# ----------------------------------------------------------
# Build metadata (set by CI/CD; leave empty locally)
# NEXT_PUBLIC_APP_VERSION defaults to package.json "version".
# ----------------------------------------------------------

NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_GIT_SHA=
