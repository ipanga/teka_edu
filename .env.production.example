# PRODUCTION reference values (Vercel Production + Supabase PROD project `teka-edu-prod`).
#
# Documents what the Vercel Production environment must contain. Not loaded by Next.js.
# Configure these values in Vercel (see docs/ENVIRONMENT_SETUP.md).
# NO REAL PRODUCTION SECRET may ever be committed to Git.

NEXT_PUBLIC_APP_NAME=Teka Edu
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_COUNTRY=CD

NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_APP_URL=<PRODUCTION_DOMAIN>

NEXT_PUBLIC_SUPABASE_URL=https://<PROD_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PROD_SUPABASE_PUBLISHABLE_KEY>

SUPABASE_SECRET_KEY=<PROD_SUPABASE_SECRET_KEY>

DATABASE_URL=<PROD_SUPABASE_DATABASE_POOLER_URL>
DIRECT_DATABASE_URL=<PROD_SUPABASE_DIRECT_DATABASE_URL>

NEXT_PUBLIC_ENABLE_ENGLISH_SCAFFOLDING=true
# The spec's target value is true. Keep false until cloud sync is implemented and has
# been validated on staging.
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

AI_ENABLED=false

# Vercel routes traffic to this port; the container listens on it (Dockerfile.vercel).
PORT=3000
